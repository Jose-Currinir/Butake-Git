---
// Diagrama de la portada: ramas main/develop/feature con commits que avanzan, y alrededor,
// las herramientas con las que trabaja Butake Git orbitando. Monocromo; respeta reducir movimiento.
import Icon from './Icon.astro'

const orbit = [
  { icon: 'github-fill', label: 'GitHub' },
  { icon: 'git-repository-line', label: 'Bitbucket' },
  { icon: 'apple-fill', label: 'macOS' },
  { icon: 'terminal-box-line', label: 'Terminal' },
  { icon: 'robot-2-line', label: 'Agentes de IA' },
  { icon: 'shield-check-line', label: 'Seguridad' },
  { icon: 'git-pull-request-line', label: 'Pull requests' },
  { icon: 'code-s-slash-line', label: 'Código' },
]
const R = 47 // % del radio para los nodos
---
<div class="orbita" role="img" aria-label="Diagrama de ramas main, develop y feature con commits que se integran, rodeado de GitHub, Bitbucket, macOS, terminal y agentes de IA">
  <div class="anillo anillo-externo"></div>
  <div class="anillo anillo-medio"></div>
  <div class="giro">
    {orbit.map((item, i) => {
      const angulo = (i / orbit.length) * Math.PI * 2 - Math.PI / 2
      const x = 50 + R * Math.cos(angulo), y = 50 + R * Math.sin(angulo)
      return (
        <span class="nodo" style={`left:${x}%;top:${y}%`} title={item.label}>
          <span class="nodo-interior"><Icon name={item.icon} size={20} /></span>
        </span>
      )
    })}
  </div>
  <svg class="grafo" viewBox="0 0 240 240" aria-hidden="true">
    <defs>
      <path id="ruta-feature" d="M120 40 C120 70 170 70 170 100 L170 140 C170 170 120 170 120 200" />
      <path id="ruta-hotfix" d="M70 60 L70 120 C70 150 120 150 120 175" />
    </defs>
    <!-- develop (centro), main (izquierda), feature (derecha) -->
    <line class="rama rama-fuerte" x1="120" y1="22" x2="120" y2="218" />
    <path class="rama" d="M120 40 C120 70 170 70 170 100 L170 140 C170 170 120 170 120 200" />
    <path class="rama rama-tenue" d="M70 30 L70 120 C70 150 120 150 120 175" />
    <text class="etiqueta" x="126" y="20">develop</text>
    <text class="etiqueta" x="176" y="96">feature</text>
    <text class="etiqueta" x="34" y="28">main</text>
    {[40, 70, 110, 150, 200].map((y) => <circle class="commit" cx="120" cy={y} r="5" />)}
    {[100, 125, 140].map((y) => <circle class="commit commit-claro" cx="170" cy={y} r="4.5" />)}
    {[50, 90].map((y) => <circle class="commit commit-claro" cx="70" cy={y} r="4.5" />)}
    <circle class="commit commit-merge" cx="120" cy="200" r="7" />
    <circle class="viajero" r="3.2"><animateMotion dur="5.5s" repeatCount="indefinite"><mpath href="#ruta-feature" /></animateMotion></circle>
    <circle class="viajero viajero-tenue" r="2.8"><animateMotion dur="7s" begin="1.5s" repeatCount="indefinite"><mpath href="#ruta-hotfix" /></animateMotion></circle>
  </svg>
  <div class="centro">
    <span class="centro-punto" aria-hidden="true"></span>
    Sincronizada
  </div>
</div>

<style>
  .orbita { position: relative; width: min(100%, 500px); aspect-ratio: 1; margin-inline: auto; }
  .anillo { position: absolute; border-radius: 50%; border: 1px dashed var(--line-strong); opacity: .55; }
  .anillo-externo { inset: 3%; }
  .anillo-medio { inset: 20%; border-style: solid; border-color: var(--line); opacity: 1; background: radial-gradient(circle, color-mix(in srgb, var(--text) 4%, transparent), transparent 70%); }
  .giro { position: absolute; inset: 0; animation: girar 60s linear infinite; }
  .nodo { position: absolute; transform: translate(-50%, -50%); }
  .nodo-interior { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 14px; background: var(--surface); border: 1px solid var(--line); color: var(--text); box-shadow: var(--shadow-surface); animation: girar 60s linear infinite reverse; transition: transform var(--motion-fast), border-color var(--motion-fast); }
  .nodo:hover .nodo-interior { border-color: var(--line-strong); transform: scale(1.08); }
  .grafo { position: absolute; inset: 22%; width: 56%; height: 56%; overflow: visible; }
  .rama { fill: none; stroke: var(--line-strong); stroke-width: 2; stroke-linecap: round; stroke-dasharray: 420; stroke-dashoffset: 420; animation: trazar 1.6s cubic-bezier(.16, 1, .3, 1) .5s forwards; }
  .rama-fuerte { stroke: var(--text); stroke-width: 2.4; }
  .rama-tenue { stroke-dasharray: 4 5; stroke-dashoffset: 0; animation: none; opacity: .7; }
  .etiqueta { font: 600 8.5px var(--font-sans); fill: var(--muted); letter-spacing: .02em; }
  .commit { fill: var(--surface); stroke: var(--text); stroke-width: 2; opacity: 0; animation: aparecer .4s ease forwards; }
  .commit:nth-of-type(2) { animation-delay: .7s } .commit:nth-of-type(3) { animation-delay: .8s }
  .commit-claro { stroke: var(--muted); }
  .commit-merge { fill: var(--text); animation-delay: 1.3s; }
  .commit { animation-delay: .9s; }
  .viajero { fill: var(--text); }
  .viajero-tenue { fill: var(--muted); }
  .centro { position: absolute; left: 50%; bottom: -3%; transform: translateX(-50%); display: inline-flex; align-items: center; gap: 8px; padding: 7px 14px; border-radius: var(--radius-pill); background: var(--surface); border: 1px solid var(--line); font-size: 13px; font-weight: 600; box-shadow: var(--shadow-surface); }
  .centro-punto { width: 8px; height: 8px; border-radius: 50%; background: var(--butake-status-active); animation: latir 2.4s ease-out infinite; }
  @keyframes girar { to { transform: rotate(360deg); } }
  @keyframes trazar { to { stroke-dashoffset: 0; } }
  @keyframes aparecer { to { opacity: 1; } }
  @keyframes latir { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--butake-status-active) 50%, transparent); } 70%, 100% { box-shadow: 0 0 0 8px transparent; } }
  @media (prefers-reduced-motion: reduce) {
    .giro, .nodo-interior, .centro-punto { animation: none; }
    .rama { animation: none; stroke-dashoffset: 0; }
    .commit { animation: none; opacity: 1; }
    .viajero { display: none; }
  }
</style>
